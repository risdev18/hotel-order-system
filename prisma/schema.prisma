generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Table {
  id          String   @id @default(cuid())
  tableNumber String   @unique // e.g. T01, T02
  qrCodeUrl   String?
  status      String   @default("free") // "free", "occupied"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  orders      Order[]
  calls       WaiterCall[]
}

model MenuCategory {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  items     MenuItem[]
}

model MenuItem {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  price       Float
  vegFlag     Boolean  @default(true) // true = veg, false = non-veg
  imageUrl    String?
  isAvailable Boolean  @default(true)
  description String?
  
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
}

model Order {
  id            String   @id @default(cuid())
  tableId       String
  status        String   @default("placed") // "placed", "accepted", "preparing", "served", "paid"
  paymentStatus String   @default("unpaid") // "unpaid", "paid_online", "paid_counter"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  table         Table    @relation(fields: [tableId], references: [id])
  items         OrderItem[]
  bill          Bill?
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  menuItemId       String
  quantity         Int      @default(1)
  notes            String?
  priceAtOrderTime Float
  status           String   @default("pending") // "pending", "preparing", "served"

  order            Order    @relation(fields: [orderId], references: [id])
  menuItem         MenuItem @relation(fields: [menuItemId], references: [id])
}

model Bill {
  id            String   @id @default(cuid())
  orderId       String   @unique
  subtotal      Float
  tax           Float
  serviceCharge Float
  total         Float
  paymentMethod String?
  paidAt        DateTime?
  
  order         Order    @relation(fields: [orderId], references: [id])
}

model Staff {
  id           String   @id @default(cuid())
  name         String
  role         String   @default("waiter") // "admin", "waiter"
  phone        String   @unique
  passwordHash String
}

model WaiterCall {
  id        String   @id @default(cuid())
  tableId   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  table     Table    @relation(fields: [tableId], references: [id])
}

model StoreSettings {
  id            String   @id @default(cuid())
  name          String   @default("The Royal Dhaba")
  logoUrl       String?
  tableCount    Int      @default(30)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
