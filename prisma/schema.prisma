generator client {
  provider = "prisma-client-js"
  // FORCE_VERCEL_REBUILD_CACHE_1
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id          String   @id @default(cuid())
  slug        String   @unique // e.g. "spice-grill"
  name        String
  logoUrl     String?
  tableCount  Int      @default(30)
  password    String   // Admin login password for this specific restaurant
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tables      Table[]
  categories  MenuCategory[]
  orders      Order[]
}

model Table {
  id           String   @id @default(cuid())
  restaurantId String
  tableNumber  String
  qrCodeUrl    String?
  status       String   @default("free") // "free", "occupied"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  calls        WaiterCall[]

  @@unique([restaurantId, tableNumber])
}

model MenuCategory {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int      @default(0)

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuItem[]
}

model MenuItem {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  price       Float
  vegFlag     Boolean  @default(true)
  imageUrl    String?
  isAvailable Boolean  @default(true)
  description String?
  
  category    MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
}

model Order {
  id            String   @id @default(cuid())
  restaurantId  String
  tableId       String
  status        String   @default("placed") // "placed", "preparing", "served", "paid"
  paymentStatus String   @default("unpaid") // "unpaid", "paid"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table         Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  bill          Bill?
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  menuItemId       String
  quantity         Int      @default(1)
  notes            String?
  priceAtOrderTime Float
  status           String   @default("pending")

  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem         MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model Bill {
  id            String   @id @default(cuid())
  orderId       String   @unique
  subtotal      Float
  tax           Float
  serviceCharge Float
  total         Float
  paymentMethod String?
  paidAt        DateTime?
  
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model WaiterCall {
  id        String   @id @default(cuid())
  tableId   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
}
